# Institution server configuration. Copy to .env; never commit .env.
# Defaults are chosen so that a misconfigured server is closed, not open.

# --- Institution identity ---
EON_INSTITUTION_ID=
EON_INSTITUTION_NAME=

# --- Network ---
EON_BIND=127.0.0.1:8443
EON_PUBLIC_URL=

# --- Database ---
EON_DATABASE_URL=

# --- Identity provider (OIDC, madde 21) ---
# Empty -> local institution accounts only (the limited pilot mode, madde 18).
EON_OIDC_ISSUER=
EON_OIDC_CLIENT_ID=
EON_OIDC_CLIENT_SECRET=

# --- Material distribution (madde 25) ---
# HTTPS is the primary path. Peer distribution is off by default and, when enabled,
# is restricted to the local network.
EON_PEER_DISTRIBUTION=off
EON_PEER_LOCAL_NETWORK_ONLY=true

# --- Malware scanning of teacher uploads (madde 27b) ---
EON_CLAMAV_ADDR=
# A package is not published while its scan result is pending.
EON_REQUIRE_SCAN=true

# --- Signing (madde 34) ---
# The institution generates and holds this key. The project never has it.
EON_INSTITUTION_KEY_PATH=

# --- Retention (madde 31) ---
EON_AUDIT_LOG_RETENTION_DAYS=365
EON_LESSON_RECORDING_RETENTION_DAYS=30
